<mxCell id="p2_note" value="&lt;b&gt;Reglas de Puntos de Extensión (Anti-Fraude y Evaluación):&lt;/b&gt;&lt;br/&gt;• &lt;i&gt;«extend» Pérdida de Foco:&lt;/i&gt; Condición: Aprendiz cambia de pestaña o minimiza ventana.&lt;br/&gt;• &lt;i&gt;«extend» Advertencia:&lt;/i&gt; Condición: Se registra primera falta no crítica.&lt;br/&gt;• &lt;i&gt;«extend» Anulación:&lt;/i&gt; Condición: Falta flagrante o supera límite configurado.&lt;br/&gt;• &lt;i&gt;«extend» Reintento:&lt;/i&gt; Condición: [intento_fallido AND intentos_usados &amp;lt; max_intentos].&lt;br/&gt;• &lt;i&gt;«extend» Constancia:&lt;/i&gt; Condición: [puntaje_obtenido &amp;gt;= puntaje_minimo_aprobatorio (70%)]." style="shape=note;whiteSpace=wrap;html=1;size=14;verticalAlign=top;align=left;fillColor=#FEF9C3;strokeColor=#CA8A04;fontColor=#713F12;fontSize=9.5;" parent="1" vertex="1">
<mxGeometry x="670" y="910" width="540" height="110" as="geometry" />
</mxCell>
