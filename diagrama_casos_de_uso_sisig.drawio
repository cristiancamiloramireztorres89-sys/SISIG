<mxCell id="txt_leg" value="• «include»: Inclusión obligatoria.&lt;br/&gt;• «extend»: Ejecución condicional.&lt;br/&gt;• Óvalo relleno: Caso de uso base.&lt;br/&gt;• Óvalo azul: Caso incluido (include).&lt;br/&gt;• Óvalo ámbar: Caso extensor (extend).&lt;br/&gt;• Línea continua: Asociación.&lt;br/&gt;• Flecha hueca: Generalización.&lt;br/&gt;• Línea roja: Monitoreo Anti-Fraude." style="text;html=1;align=left;verticalAlign=middle;fontSize=8.5;fontColor=#334155;" parent="box_leg" vertex="1">
<mxGeometry x="5" y="25" width="180" height="160" as="geometry" />
</mxCell>
