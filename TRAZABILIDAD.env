# ==============================================================================
# SISIG - TRAZABILIDAD COMPLETA DE DESARROLLO Y CONFIGURACIÓN (AYER Y HOY)
# ==============================================================================
# Este archivo documenta detalladamente cada funcionalidad, variable y protocolo
# implementado en el sistema, especialmente la arquitectura de seguridad Anti-Trampa.
# ==============================================================================

# ------------------------------------------------------------------------------
# SECCIÓN 1: SISTEMA DE SEGURIDAD E INTEGRIDAD ACADÉMICA (ANTI-TRAMPA)
# Archivos clave:
# - Frontend Engine: Modules/SISIG/Resources/assets/js/anti-trampa.js
# - Inline Engine:   Modules/SISIG/Resources/views/aprendiz/quiz/_script_antitrampa_inline.blade.php
# - Evaluación UI:   Modules/SISIG/Resources/views/aprendiz/evaluaciones/presentar.blade.php
# - Auditoría UI:    Modules/SISIG/Resources/views/aprendiz/evaluaciones/resultado.blade.php
# - Backend Control: Modules/SISIG/Http/Controllers/aprendiz/EvaluacionesAprendizController.php
# - Panel Auditor:   Modules/SISIG/Http/Controllers/editor/InfraccionesController.php
# ------------------------------------------------------------------------------

# 1.1 Sistema de Vidas y Umbral de Tolerancia
# Define la cantidad máxima de faltas o vidas permitidas antes de la anulación inmediata.
SISIG_ANTITRAMPA_MAX_FALTAS=3

# Vidas iniciales con las que arranca cada intento de quiz
SISIG_ANTITRAMPA_VIDAS_INICIALES=3

# Tolerancia de tiempo (ms) para evitar registrar eventos dobles si la ventana pierde foco rápido
SISIG_ANTITRAMPA_COOLDOWN_MS=1200

# Margen de gracia en segundos en el servidor para evitar anular intentos por latencia de red
SISIG_ANTITRAMPA_MARGEN_GRACIA_SEGUNDOS=45

# 1.2 Interfaz de Usuario Reactiva y Corazones 3D
# Habilita los contenedores volumétricos 3D (heart-body, heart-depth, heart-rim-light, heart-shine).
# Al cometer una falta, ejecuta la animación de fractura (heart-shatter) y estado perdido (heart-lost).
SISIG_ANTITRAMPA_UI_CORAZONES_3D=true

# Indicador de estado de texto dinámico: '3 vidas' -> '2 vidas' -> '¡Última vida!' -> '0 vidas'
SISIG_ANTITRAMPA_UI_TEXTO_DINAMICO=true

# Barra de progreso reactiva: Verde (0 faltas) -> Ámbar (1 falta) -> Naranja parpadeante (2) -> Rojo (3)
SISIG_ANTITRAMPA_UI_BARRA_PROGRESO=true

# 1.3 Bloqueo Estricto de Capturas de Pantalla
# Intercepta las teclas PrintScreen, Snapshot y combinaciones de recorte del sistema operativo.
# Windows: Win + Shift + S, Shift + S
# Mac: Cmd + Shift + 3, Cmd + Shift + 4, Cmd + Shift + 5
SISIG_ANTITRAMPA_BLOQUEO_CAPTURAS=true

# Al detectar un intento de captura, se invoca navigator.clipboard.writeText('')
# para vaciar el portapapeles y neutralizar el pegado de imágenes en chats o documentos.
SISIG_ANTITRAMPA_VACIAR_PORTAPAPELES_EN_CAPTURA=true

# 1.4 Bloqueo de Atajos para Invocar Inteligencia Artificial
# Bloquea comandos nativos de navegadores y extensiones para consultar IA:
# - Brave Browser / Brave Leo AI: Ctrl + B, Alt + B
# - Microsoft Edge / Copilot AI:  Ctrl + Shift + .
# - Atajos genéricos de Copilot:  Alt + C
# - Lanzadores externos de IA:    Ctrl + Espacio, Alt + Espacio
# - Extensiones (ChatGPT, Monica, Merlin, Sider): Ctrl + Shift + L/O/E/Y/A
SISIG_ANTITRAMPA_BLOQUEO_ATAJOS_IA=true

# 1.5 Restricción de Portapapeles y Menú Contextual
# Previene la extracción de preguntas o la inserción de respuestas externas:
# - Bloqueo de eventos nativos: copy, cut, paste, contextmenu (clic derecho)
# - Bloqueo de atajos secundarios: Shift + Insert (pegar), Ctrl + Insert (copiar), Shift + Delete (cortar)
# - Selección de texto deshabilitada: user-select: none
SISIG_ANTITRAMPA_BLOQUEO_PORTAPAPELES=true

# 1.6 Detección de Foco y Cambio de Pestañas
# - VisibilityChange API: Detecta inmediatamente si el aprendiz minimiza el navegador o cambia de pestaña.
# - Window.blur: Detecta si el usuario hace clic fuera del navegador (ej. abrir bloc de notas, calculadora, chat).
SISIG_ANTITRAMPA_DETECCION_FOCO=true

# 1.7 Bloqueo de Inspección y Herramientas de Desarrollador (DevTools)
# - Bloqueo de teclas funcionales: F12 (DevTools), F5 (recarga forzada), F3 (búsqueda de texto)
# - Bloqueo de combinaciones: Ctrl + Shift + I, Ctrl + Shift + J, Ctrl + Shift + C
# - Bloqueo de visualización de código fuente: Ctrl + U
SISIG_ANTITRAMPA_BLOQUEO_DEVTOOLS=true

# 1.8 Protocolo de Registro Asíncrono y Anulación Automática
# - Cada incidente se envía por AJAX/Fetch hacia: /aprendiz/evaluaciones/{id_resultado}/incidente
# - Se almacena en la tabla 'infraccionesquiz' con IP, User-Agent, fecha, tipo de falta y detalle.
# - Al acumular 3 faltas:
#   1. El servidor actualiza el registro con 'fue_anulado = true'.
#   2. Asigna puntaje 0.00% y aprobado = false.
#   3. Registra el motivo exacto de la anulación en la base de datos.
#   4. El frontend bloquea inmediatamente la interfaz y redirige a la vista de resultados.
SISIG_ANTITRAMPA_AUTO_ANULACION=true

# 1.9 Validación de Integridad en el Servidor (Zero Trust)
# El backend nunca confía únicamente en el cliente:
# - Al procesar calificar(): Valida si transcurrió más tiempo que el límite + gracia.
# - Valida si el contador de infracciones en base de datos superó el umbral.
# - En caso afirmativo, anula la prueba en el servidor independientemente de lo enviado por el navegador.
SISIG_ANTITRAMPA_VALIDACION_SERVIDOR=true

# 1.10 Módulo de Auditoría de Infracciones para el Editor
# Ruta: /editor/infracciones
# Permite a los instructores/editores auditar aprendices anulados por trampa, consultar
# el desglose cronológico de incidentes, número de vidas perdidas y motivos de penalización.
SISIG_ANTITRAMPA_PANEL_AUDITORIA_EDITOR=true


# ------------------------------------------------------------------------------
# SECCIÓN 2: ACCESO DIRECTO A EVALUACIONES (MODIFICACIÓN DE FLUJO)
# Archivos clave:
# - Modules/SISIG/Http/Controllers/aprendiz/InduccionAprendizController.php
# - Modules/SISIG/Http/Controllers/aprendiz/DashboardControllerAprendiz.php
# - Modules/SISIG/Resources/views/aprendiz/induccion/show.blade.php
# - Modules/SISIG/Resources/views/aprendiz/evaluaciones/evaluaciones.blade.php
# ------------------------------------------------------------------------------

# Requisito previo de lectura obligatoria del material didáctico antes de rendir el quiz
# ESTADO: FALSE (Se eliminó la restricción a solicitud del usuario para permitir que el
# aprendiz pueda ingresar a evaluar sus conocimientos directamente sin forzar lectura previa).
SISIG_QUIZ_REQUIERE_LECTURA_PREVIA=false

# Porcentaje mínimo de aprobación institucional para considerar un quiz superado (70%)
SISIG_QUIZ_PUNTAJE_MINIMO_APROBACION=70.00

# Intentos máximos permitidos por evaluación antes de agotar la prueba (por defecto: 3)
SISIG_QUIZ_NUMERO_INTENTOS_DEFAULT=3


# ------------------------------------------------------------------------------
# SECCIÓN 3: FILTROS DINÁMICOS DE SECCIONES SIG (CARRUSEL SLIDER DE 3 MÓDULOS)
# Archivos clave:
# - Editor Reportes:      Modules/SISIG/Resources/views/editor/reportes/index.blade.php
# - Editor Reportes Ctrl: Modules/SISIG/Http/Controllers/editor/ReportesController.php
# - Aprendiz Evaluaciones: Modules/SISIG/Resources/views/aprendiz/evaluaciones/evaluaciones.blade.php
# - Aprendiz Historial:    Modules/SISIG/Resources/views/aprendiz/historial/historial.blade.php
# - Editor Participantes:  Modules/SISIG/Resources/views/editor/participantes/index.blade.php
# - Editor Infracciones:   Modules/SISIG/Resources/views/editor/infracciones/index.blade.php
# ------------------------------------------------------------------------------

# Origen de datos: Consulta directa y dinámica a la tabla 'sisig_modulos'
# (Se eliminaron las listas estáticas 'Calidad, SST, Ambiental'; si se crea un nuevo
# módulo en la base de datos, el sistema lo toma automáticamente en tiempo real).
SISIG_FILTROS_ORIGEN_DATOS=database_dynamic

# Capacidad visual estricta del contenedor: Muestra exactamente 3 módulos a la vez
# Fórmula matemática CSS: flex: 0 0 calc((100% - 12px) / 3) dentro de w-[240px..300px]
SISIG_FILTROS_CAPACIDAD_VISIBLE=3

# Flechas de desplazamiento lateral (< y >): Se activan automáticamente si hay más de 3 módulos
SISIG_FILTROS_FLECHAS_NAVEGACION=true

# Desplazamiento por clic: Mueve suavemente (smooth) exactamente 1 módulo por pulsación (1/3 visible)
SISIG_FILTROS_PASO_SCROLL="1/3"

# Ocultamiento de la barra de scroll nativa del navegador (scrollbar-width: none / -webkit-scrollbar: none)
SISIG_FILTROS_OCULTAR_SCROLLBAR=true

# Retiro de logos e iconos en las pastillas de los filtros para mantener diseño sobrio y limpio
# ESTADO: FALSE (Únicamente muestra el texto del módulo: Calidad, Ambiental, SST, aaaa, etc.)
SISIG_FILTROS_MOSTRAR_LOGOS=false

# Auto-centrado al cargar la página: Si el módulo seleccionado está fuera de vista, se auto-desplaza
SISIG_FILTROS_AUTO_CENTRAR_ACTIVO=true

# Generalización transversal: La experiencia del filtro carrusel aplica tanto en Editor como en Aprendiz
SISIG_FILTROS_GENERALIZADOS=true


# ------------------------------------------------------------------------------
# SECCIÓN 4: PERSONALIZACIÓN DE MÓDULOS Y LIBRERÍAS LOCALES (TRABAJO DE AYER)
# Archivos clave:
# - Modules/SISIG/Database/Migrations/2026_10_19_000001_add_imagen_to_sisig_modulos_table.php
# - Modules/SISIG/Database/Migrations/2026_10_19_000002_add_fondo_to_sisig_modulos_table.php
# - Modules/SISIG/Entities/Modulo.php
# - Modules/SISIG/Http/Controllers/admin/GestionModulosController.php
# - Modules/SISIG/Resources/views/admin/GestionModulos.blade.php
# - Modules/SISIG/Resources/views/admin/ContenidoModulo.blade.php
# ------------------------------------------------------------------------------

# Soporte de imagen representativa del módulo (almacenada en public/modules/sisig/images/modulos)
SISIG_MODULOS_SOPORTE_IMAGEN=true

# Soporte de imagen de fondo institucional con control de opacidad ajustable (0 a 100%)
SISIG_MODULOS_SOPORTE_FONDO_OPACIDAD=true

# Librería de recorte Cropper.js instalada localmente sin dependencia de CDN
SISIG_VENDOR_CROPPER_LOCAL=true

# Editor de texto enriquecido Quill.js instalado localmente con soporte de temas y formato
SISIG_VENDOR_QUILL_LOCAL=true


# ------------------------------------------------------------------------------
# SECCIÓN 5: DISEÑO VISUAL, CONTRASTE TIPOGRÁFICO Y PROTECCIÓN DE DATOS
# ------------------------------------------------------------------------------

# Alto contraste en tipografía de tablas, modales e informes (texto negro/slate-800)
# Se corrigieron los estilos grises tenues que dificultaban la lectura de aprendices y notas.
SISIG_UI_CONTRASTE_TEXTO="slate-800"

# Métricas reactivas y gráficas basadas en registros reales de la base de datos
SISIG_REPORTES_METRICAS_REACTIVAS=true

# POLÍTICA ESTRICTA DE BASE DE DATOS:
# Se prohibió expresamente alterar la estructura de tablas existentes o ejecutar modificaciones
# destructivas que pudieran romper la sincronización con la rama principal de producción.
SISIG_DB_PROTECCION_ESQUEMA_ESTRICTO=true
